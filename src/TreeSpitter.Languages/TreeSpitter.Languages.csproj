<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Precompiled TreeSpitter parsers of 27 tree-sitter grammars (Agda, Bash, C, C++, C#, CSS, Embedded Template, Go, Haskell, HTML, Java, JavaScript, JSDoc, JSON, Julia, OCaml, PHP, Python, QL, Razor, Ruby, Rust, Scala, TSX, TypeScript, Verilog), with their external scanners ported to C#: the tables are compiled at build time.</Description>
    <PackageTags>tree-sitter;parser;agda;bash;c;cpp;csharp;css;go;haskell;html;java;javascript;jsdoc;json;julia;ocaml;php;python;ql;razor;ruby;rust;scala;typescript;verilog</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TreeSpitter/TreeSpitter.csproj" />
    <ProjectReference Include="../TreeSpitter.Generators/TreeSpitter.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The grammars, compiled by the source generator. -->
    <AdditionalFiles Include="../../grammars/*/grammar.json" LinkBase="Grammars" />
    <!-- A development build can generate only some grammars, to build faster: TreeSpitterGrammars=json,ruby dotnet build -->
    <CompilerVisibleProperty Include="TreeSpitterGrammars" />
    <AssemblyMetadata Include="TreeSpitterGrammars" Value="$(TreeSpitterGrammars)" Condition="'$(TreeSpitterGrammars)' != ''" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses/THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
