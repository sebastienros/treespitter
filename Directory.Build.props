<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- C# 15 requires the .NET 11 SDK (see global.json); the library still targets netstandard2.0 and net10.0. -->
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Sébastien Ros</Authors>
    <Copyright>Copyright (c) 2026 Sébastien Ros</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sebastienros/treespitter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sebastienros/treespitter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Non-secret development strong-name key, so signed .NET Framework hosts can reference the netstandard2.0 build
         (Jint is strong-named too); not a production identity or an authenticity guarantee. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)TreeSpitter.Development.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
  </PropertyGroup>
</Project>
